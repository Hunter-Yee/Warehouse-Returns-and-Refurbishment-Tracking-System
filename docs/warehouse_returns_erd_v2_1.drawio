            <Array as="points">
              <mxPoint x="2124" y="2159" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="workflow_n477" value="1 / P" style="shape=rect;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.6;fontFamily=Helvetica;fontSize=16;fontColor=#142C3D;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="2040" width="70" height="25" as="geometry" />
        </mxCell>
        <mxCell id="workflow_n478" value="N / T" style="shape=rect;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1.6;fontFamily=Helvetica;fontSize=16;fontColor=#142C3D;fontStyle=1;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="2130" y="2080" width="70" height="25" as="geometry" />
        </mxCell>
        <mxCell id="workflow_n479" value="Inspection to WorkOrder is optional in the general model.&#10;Initial has no order. PostRepair and repaired-item Final must&#10;reference the same item's latest completed order, at/after completion." style="shape=text;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A9BAC6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=19;fontColor=#526575;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="720" y="1940" width="1030" height="95" as="geometry" />
        </mxCell>
        <mxCell id="workflow_n480" value="FK I = composite ReturnItem FK (ReturnID, LineNumber).&#10;FK U = User; FK R = ReferenceValue; see tab 02 for each link." style="shape=text;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A9BAC6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=18;fontColor=#526575;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="720" y="2040" width="1030" height="55" as="geometry" />
        </mxCell>
        <mxCell id="workflow_n481" value="PK = primary key (underlined)   FK = foreign key   UK = unique key   NULL = nullable; other attributes required.&#10;Endpoint 1 / N / M = maximum cardinality. T = total participation (double line); P = partial participation (single line).&#10;1:N and N:1 are opposite readings of one relationship. Optionality is separate from maximum cardinality." style="shape=text;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A9BAC6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=18;fontColor=#526575;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="2260" width="2380" height="75" as="geometry" />
        </mxCell>
        <mxCell id="workflow_n482" value="Proposed MySQL types: INT / BIGINT / SMALLINT are UNSIGNED; TS = DATETIME(6); MONEY = DECIMAL(12,2);&#10;Vn = VARCHAR(n); BOOL = TINYINT(1). Composite FKs use all listed columns together. Dates use the warehouse time zone." style="shape=text;rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A9BAC6;strokeWidth=1.6;fontFamily=Helvetica;fontSize=18;fontColor=#526575;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="2343" width="2380" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
